[Unit]
Description=kpidash client daemon (telemetry/health reporter)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The one copy of the Redis password on this host (root:khomelab 0640).
#
# READ THIS BEFORE COPYING THE SYSTEM UNIT'S COMMENT HERE: a USER unit is not
# started by PID 1. `systemd --user` runs as you, so it reads EnvironmentFile=
# with YOUR credentials and needs an effective khomelab membership — being
# listed in /etc/group is not enough. The user manager takes its supplementary
# groups when it starts, and with `loginctl enable-linger` it outlives every
# login, so a group added afterwards does not reach it until the manager itself
# restarts (a reboot, or `loginctl terminate-user`). install.sh checks the
# manager's real credentials rather than /etc/group, for exactly this reason.
EnvironmentFile=/etc/khomelab/secrets.env
ExecStart=__KPIDASH_CLIENT_EXEC__ daemon start --foreground
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
