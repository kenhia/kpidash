# kpidash dashboard configuration -- non-secret, 0644 root:root.
#
# Installed to /etc/kpidash/config.env and read by kpidash.service as an
# optional EnvironmentFile. Everything the dashboard takes from the environment
# except the Redis password belongs here; the password lives once per host in
# /etc/khomelab/secrets.env and is not repeated in this repo or on this Pi.
#
# See docs/HANDOFF-CROSSCOMPILE.md for the full variable list and defaults.

# Hostnames that are never evicted from the client registry.
KPIDASH_PRIORITY_CLIENTS=kai,kubs0,cleo
